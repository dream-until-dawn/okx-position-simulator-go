{
  "_provenance": {
    "用途": "含挂单时全仓保证金率的分子与分母",
    "为什么此前测不出": "旧样本里挂单很小，两个候选公式的差落在漂移噪声里。这次把持仓压到 100 张、挂单挂到 1900 张，差值放大到分母的一成以上",
    "标的": "BTC-USD-SWAP 全仓空头",
    "取得": "2026-09-01"
  },
  "_calibrated": {
    "公式": "保证金率 = (现金 + 全仓浮盈 − Σ挂单开仓手续费) / (mmr(合并) + 合并名义 × 吃单费率)",
    "分母": {
      "结论": "开仓挂单也计一份平仓手续费",
      "反直觉": "「尚未成交的委托没有可平的仓位，也就没有平仓手续费」听着合理，实测是错的",
      "证据": "持仓 100 张 + 挂单 1900 张时，排除挂单算出的保证金率比真实值高 12%（误差 +1.036e+1，而真实值 86.94）；计入后误差降到 +8.8e-2"
    },
    "分子": {
      "结论": "要扣掉挂单冻结的开仓手续费",
      "证据": "eq −(availBal + imr) 恰好等于挂单按【委托价】算的名义 × 吃单费率，三个差异极大的委托价（现价 ×1.05 / ×1.50 / ×2.00）下逐位吻合，残差 1e-17",
      "怎么发现的": "只改分母后仍有稳定的 +1.0e-3 相对残差，三个样本一致到第六位，不是噪声。换分子为 availBal+imr 后，费用项在三个委托价下一律精确等于 0.0005"
    },
    "mmr 单独核过": "我的 mmr 公式与 OKX 报的 mmr 字段吻合到 1e-6，一个无漂移样本上是 3.5e-16",
    "独立验证": "旧夹具 cross-position-metrics 里那个含挂单的快照，此前有 2e-4 相对残差、当初判为取数时点。改用本公式后同一份数据在 5e-7 容差下仍然通过——该数据未参与本次推导"
  },
